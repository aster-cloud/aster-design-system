{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    // ★TypeScript 7 移除了 moduleResolution: "Node"（即旧的 node10），
    // 沿用会直接报 TS5108 而构建失败。CommonJS 产物改用 "node16"：
    // 它是 TS 现行支持的 Node 解析策略，仍产出 CJS（本包的 main /
    // exports.require 指向 dist/cjs，是对外发布物，不能丢）。
    "moduleResolution": "node16",
    "outDir": "dist/cjs",
    "rootDir": "src",
    // ★CJS 产物必须自带 .d.ts：dist/cjs/package.json 标 commonjs，
    // 这里生成的声明才会被 TS 当作 CJS 模块。若 CJS 消费方（node16
    // 解析、无 "type":"module"）被 exports 指到 dist/esm 的声明，
    // TS 会按 ESM 处理并报 TS1479「不能用 require 导入」——运行时
    // require() 明明正常，类型却说不行。
    "declaration": true,
    "declarationMap": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*"]
}
