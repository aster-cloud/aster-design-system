{
  "name": "storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build -o storybook-static --stats-json",
    "build-storybook": "storybook build -o storybook-static --stats-json",
