{
  "name": "aster-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Aster brand tokens + UI primitives, shared by aster-cloud and aster-lang-dev",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" build",
    "storybook": "pnpm --filter=storybook dev",
    "storybook:build": "pnpm --filter=storybook build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0 <0.26.0",
      "ws": ">=8.21.0 <9",
      "brace-expansion": ">=5.0.7 <6",
      "@babel/core": ">=7.29.6 <8",
      "vite": ">=6.4.3 <7"
    }
  }
}
